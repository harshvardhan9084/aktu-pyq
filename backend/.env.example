# Copy to .env and fill in real values — NEVER commit .env to GitHub

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS — your Vercel frontend URL
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Random strong string — used to authenticate admin API calls from frontend.
# This MUST match: sha256(ADMIN_PASSWORD_HASH + 'session_salt_aktu_pyq')
# where ADMIN_PASSWORD_HASH is set in your frontend .env.local (Vercel)
ADMIN_API_TOKEN=make_up_a_long_random_string_here

# Local paths
CHROMA_PERSIST_PATH=./chroma_db
