# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# Supabase (get from supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend URL (your Render FastAPI URL, or localhost for dev)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Admin panel password hash (SHA-256 of your password)
# Generate at: https://codebeautify.org/sha256-hash-generator
ADMIN_PASSWORD_HASH=replacethiswithyoursha256hash
